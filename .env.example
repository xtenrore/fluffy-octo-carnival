# Arc Agent server
PORT=3000
HOST=127.0.0.1

# Optional persistent data directory. Railway deployment uses /data.
# DATA_DIR=/data

# Optional. If omitted, Arc generates and persists a local encryption key in .data/master.key.
# In production, set a stable 32-byte base64 secret and back it up securely.
# APP_MASTER_KEY_BASE64=

# DANGEROUS. Enables the account setting that lets an agent execute arbitrary shell commands
# on the server host. Keep OFF on shared/public deployments. Default: 0
ENABLE_HOST_TERMINAL=0

# Optional canonical origin for stricter origin checks in production, e.g. https://arc.example.com
# APP_ORIGIN=
